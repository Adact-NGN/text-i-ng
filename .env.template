# =============================================
# TextiNG SMS Application - Environment Variables
# =============================================
# Copy this file to .env.local and fill in your values
#
# Quick Start:
# 1. Copy: cp .env.template .env.local
# 2. Fill in the values below
# 3. Save and run: npm run dev

# =============================================
# DATABASE (Required)
# =============================================
# Neon/Vercel Postgres connection string
# Get from: Vercel Dashboard > Storage > Postgres > Connection String
# Or: Neon Console > Connection Details
texting_POSTGRES_URL=
POSTGRES_URL=

# Optional: Non-pooled connection (for migrations)
texting_POSTGRES_URL_NON_POOLING=
POSTGRES_URL_NON_POOLING=

# =============================================
# TWILIO SMS SERVICE (Required)
# =============================================
# Get from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# =============================================
# AZURE AD AUTHENTICATION (Required)
# =============================================
# Get from: Azure Portal > App Registrations
# See AZURE_AD_SETUP.md for detailed instructions
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# =============================================
# NEXTAUTH (Required)
# =============================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Local development
NEXTAUTH_URL=http://localhost:3000

# Production (uncomment and update for production)
# NEXTAUTH_URL=https://text-i-ng.vercel.app

# =============================================
# OPTIONAL CONFIGURATION
# =============================================

# Authorization: Comma-separated list of allowed domains
# Leave empty to allow all Azure AD authenticated users
AUTHORIZED_DOMAINS=

# Debug mode for NextAuth (set to true for troubleshooting)
# NEXTAUTH_DEBUG=true

# Microsoft Graph API token (for Azure AD group features)
# MICROSOFT_GRAPH_TOKEN=
